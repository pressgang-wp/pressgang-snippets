{% extends 'snippets/seo/json-ld/script.twig' %}

{% block schema %}
  {% set schema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    'publisher': {
      '@id': publisher
    },
    'author': author,
    'headline': headline,
    'articleBody': article_body,
    'image': image,
    'datePublished': date_published,
    'dateModified': date_modified,
    'mainEntityOfPage': main_entity_of_page
  } %}
  {{ schema|json_encode|raw }}
{% endblock %}
