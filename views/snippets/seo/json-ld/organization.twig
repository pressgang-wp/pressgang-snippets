{% extends 'snippets/seo/json-ld/script.twig' %}

{% block schema %}
  {% set schema = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': id,
    'name': name,
    'logo': logo,
    'sameAs': same_as,
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': address_locality,
      'addressRegion': address_region,
      'postalCode': postal_code,
      'streetAddress': street_address
    },
    'email': email,
    'telephone': telephone,
    'vatID': vat_id
  } %}
  {{ schema|json_encode|raw }}
{% endblock %}
