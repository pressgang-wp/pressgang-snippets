{% extends 'json-ld/script.twig' %}

{% block schema %}
  {% set schema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': id,
    'name': name,
    'url': url,
    'potentialAction': {
      '@type': 'SearchAction',
      'target': url ~ '?s={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  } %}
  {{ schema|json_encode|raw }}
{% endblock %}
