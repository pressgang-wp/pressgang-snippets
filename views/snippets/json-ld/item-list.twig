<script type="application/ld+json">
  {% set item_list = [] %}
  {% for item in items %}
    {% set item_list = item_list|merge([{
      '@type': 'ListItem',
      'position': loop.index,
      'url': item.link
    }]) %}
  {% endfor %}
  {% set schema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    'itemListElement': item_list
  } %}
  {{ schema|json_encode|raw }}
</script>
