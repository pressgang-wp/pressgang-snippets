{% extends 'json-ld/script.twig' %}

{% block schema %}
  {% set schema = {
    '@context': 'https://schema.org',
    '@type': 'Recipe',
    'name': name,
    'image': images,
    'datePublished': date_published,
    'description': description
  } %}
  {% if prep_time %}
    {% set schema = schema|merge({ 'prepTime': prep_time }) %}
  {% endif %}
  {% if cook_time %}
    {% set schema = schema|merge({ 'cookTime': cook_time }) %}
  {% endif %}
  {% if total_time %}
    {% set schema = schema|merge({ 'totalTime': total_time }) %}
  {% endif %}
  {% if keywords %}
    {% set schema = schema|merge({ 'keywords': keywords|join(', ') }) %}
  {% endif %}
  {% if recipe_yield %}
    {% set schema = schema|merge({ 'recipeYield': '%d servings'|format(recipe_yield) }) %}
  {% endif %}
  {% if recipe_category %}
    {% set schema = schema|merge({ 'recipeCategory': recipe_category }) %}
  {% endif %}
  {% if recipe_cuisine %}
    {% set schema = schema|merge({ 'recipeCuisine': recipe_cuisine }) %}
  {% endif %}
  {% if recipe_ingredients %}
    {% set schema = schema|merge({ 'recipeIngredient': recipe_ingredients }) %}
  {% endif %}
  {% if recipe_instructions %}
    {% set instruction_list = [] %}
    {% for step in recipe_instructions %}
      {% set instruction_list = instruction_list|merge([{
        '@type': 'HowToStep',
        'text': step
      }]) %}
    {% endfor %}
    {% set schema = schema|merge({ 'recipeInstructions': instruction_list }) %}
  {% endif %}
  {{ schema|json_encode|raw }}
{% endblock %}
